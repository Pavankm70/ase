<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | ASE</title>

  <!-- GOOGLE FONTS -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, #e0f2fe, transparent 40%),
        radial-gradient(circle at bottom right, #bae6fd, transparent 40%),
        linear-gradient(135deg, #f8fbff, #eef6ff);
      background-size: 200% 200%;
      animation: bgMove 12s ease infinite;
      font-family: 'Inter', sans-serif;
    }

    @keyframes bgMove {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    header {
      width: 100%;
      padding: 20px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      border-bottom: 1px solid #e5e7eb;
    }

    header nav a {
      margin-left: 30px;
      text-decoration: none;
      color: #000;
      font-weight: 600;
    }

    .center-wrapper {
      min-height: calc(100vh - 80px);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .login-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(18px);
      width: 100%;
      max-width: 400px;
      padding: 48px 38px;
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 30px 60px rgba(14, 165, 233, 0.18);
      text-align: center;
      animation: floatIn 0.7s ease;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .login-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 40px 80px rgba(14,165,233,0.28);
    }

    @keyframes floatIn {
      from {
        opacity: 0;
        transform: translateY(25px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo-img {
      width: 92px;
      margin-bottom: 10px;
      animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    .welcome-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: #0284c7;
      font-weight: 700;
      letter-spacing: 2.5px;
      margin-bottom: 24px;
      text-transform: uppercase;
    }

    h2 {
      color: #0f172a;
      font-size: 27px;
      margin-bottom: 32px;
      font-weight: 800;
    }

    .form-group {
      text-align: left;
      margin-bottom: 20px;
    }

    .form-group label {
      font-weight: 600;
      margin-bottom: 8px;
      display: block;
      color: #475569;
      font-size: 13px;
    }

    .form-group input {
      width: 100%;
      padding: 15px 16px;
      border-radius: 14px;
      border: 1.6px solid #e2e8f0;
      font-size: 15px;
      background: #f8fafc;
      transition: all 0.25s ease;
    }

    .form-group input:hover {
      transform: translateY(-1px);
    }

    .form-group input:focus {
      outline: none;
      border-color: #0ea5e9;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(14,165,233,0.18);
    }

    .login-btn {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #0ea5e9, #0284c7);
      color: white;
      border: none;
      border-radius: 14px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 14px;
      transition: all 0.25s ease;
      box-shadow: 0 10px 25px rgba(14,165,233,0.35);
      position: relative;
      overflow: hidden;
    }

    .login-btn:active {
      transform: scale(0.96);
    }

    .login-btn::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.25);
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .login-btn:hover::after {
      opacity: 1;
    }

    .footer-text {
      margin-top: 26px;
      font-size: 14px;
      color: #64748b;
    }

    .footer-text a {
      color: #0284c7;
      font-weight: 700;
      text-decoration: none;
    }

    .footer-text a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>

  <main class="center-wrapper">
    <div class="login-card">
      <img src="/img/lod.png" alt="ASE Logo" class="logo-img">
      <p class="welcome-tag">Welcome to ASE</p>
      <h2>Login</h2>

      <form id="loginForm">
        <div class="form-group">
          <label>Name</label>
          <input type="text" placeholder="Enter your name">
        </div>

        <div class="form-group">
          <label>Password</label>
          <input type="password" placeholder="••••••••">
        </div>

        <button class="login-btn">Login</button>
      </form>

      <div class="footer-text">
        Don’t have an account? <a href="/signup">Sign Up</a>
      </div>
    </div>
  </main>

  <!-- ✅ ONLY ADDED SCRIPT -->
  <script>
    document.getElementById("loginForm").addEventListener("submit", function(e) {
      e.preventDefault();              // stop reload
      window.location.href = "/"; // go to index page
    });
  </script>

</body>
</html>
