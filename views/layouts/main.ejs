<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">

    <style>
        /* Navbar Text Color and Spacing */
        .nav li {
            margin: 0 15px; /* Adds horizontal space between list items */
        }

        .nav li a {
            color: #000000 !important; /* Forces black text */
            text-decoration: none;
            font-family: 'Rubik', sans-serif;
            font-weight: 500;
            transition: color 0.3s ease; /* Smooth transition for hover */
        }

        /* Hover effect: Blue */
        .nav li a:hover {
            color: #007bff !important; /* Bootstrap primary blue */
        }

        /* Ensure the container holds the header properly */
        .main-container {
            max-width: 1320px;
            margin: 0 auto;
        }
    </style>
</head>

<body>
    <div class="container-xxl px-md-5 bg-white shadow-lg">
        <header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 mb-4 border-bottom">
            <a href="/" class="d-flex align-items-center col-md-3 mb-2 mb-md-0 text-dark text-decoration-none">
                <img src="/img/lod.png" width="100px" height="100px" alt="Logo">
            </a>

            <ul class="nav col-12 col-md-auto mb-2 justify-content-center mb-md-0">
                <li><a href="/" class="nav-link px-2">Home</a></li>
                <li><a href="/about" class="nav-link px-2">About</a></li>
                <li><a href="/club" class="nav-link px-2">Club Members</a></li>
                <li><a href="/login" class="nav-link px-2">Log In</a></li>
                <li><a href="/signup" class="nav-link px-2">Signup</a></li>
            </ul>

            <div class="col-md-3 text-end">
                </div>
        </header>

        <main>
            <%- body %>
        </main>

      

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <script src="/js/script.js"></script>
</body>
</html>